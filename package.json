{
  "name": "finiq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "finiq_GUI/apps/*",
    "finiq_GUI/packages/*",
    "finiq_graphViewer"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:graph-viewer": "npm run dev -w @finiq/app-graph-viewer --",
    "dev:market-desk": "npm run dev -w @finiq/app-market-desk --",
    "lint:graph-viewer": "npm run lint -w @finiq/graph-viewer"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "picomatch": "^4.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-force-graph-2d": "^1.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
